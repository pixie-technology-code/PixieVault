{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixieVault",
  "version": "0.2.0",
  "identifier": "studio.pixievault.host",
  "build": {
    "frontendDist": "../host"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PixieVault Host Environment",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' asset: data: http://127.0.0.1:* http://localhost:*; frame-src 'self' http://127.0.0.1:* http://localhost:* asset: data:; connect-src 'self' http://127.0.0.1:* http://localhost:* ipc:; img-src 'self' asset: data: https: http://127.0.0.1:* http://localhost:*;"
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "apps/**/*"
    ],


    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
